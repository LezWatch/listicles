{
	"$schema": "https://json.schemastore.org/block.json",
	"apiVersion": 3,
	"version": "3.0",
	"name": "lez-library/listdt",
	"title": "Listicle Item Title",
	"category": "lezwatch",
	"icon": "migrate",
	"description": "An individual list item title.",
	"textdomain": "listicles",
	"parent": [ "lez-library/listitem" ],
	"attributes": {
		"content": {
